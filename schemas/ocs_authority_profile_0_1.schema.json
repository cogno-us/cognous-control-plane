{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogno-us/cognous-agent-control-plane/schemas/ocs_authority_profile_0_1.schema.json",
  "title": "ocs-authority-profile/0.1 (documentation schema)",
  "$comment": "NON-AUTHORITATIVE. The loader (agent_control_plane.registry_authority_profile.load_authority_profile) is the sole authority. A schema-valid document may still be refused (digest equality, key cross-references, secret and placeholder denial, mode, clock and identity rules are loader-only). Describes shape only; contains no keys. Operational mode refuses in G1/G2 code regardless of this schema.",
  "description": "Closed shape of the Configurable Authority Profile. Shape documentation only; not an admission test.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "mode",
    "verifier",
    "trust_anchor",
    "issuers",
    "expected_context",
    "snapshot",
    "clock",
    "state",
    "identities"
  ],
  "properties": {
    "version": {
      "const": "ocs-authority-profile/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "mode": {
      "enum": [
        "synthetic",
        "operational"
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "family"
      ],
      "properties": {
        "contract": {
          "const": "r08-v2"
        },
        "family": {
          "const": "f4"
        }
      }
    },
    "trust_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keys"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key_id",
              "public_key_sha256"
            ],
            "properties": {
              "key_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "public_key_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "issuers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer_id",
          "key_id",
          "grants"
        ],
        "properties": {
          "issuer_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "grants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "consumer_id",
                "tenant",
                "institution",
                "authority_domain",
                "operation"
              ],
              "properties": {
                "consumer_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "tenant": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "institution": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "authority_domain": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "operation": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              }
            }
          }
        }
      }
    },
    "expected_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "tenant",
        "institution",
        "authority_domain",
        "operation"
      ],
      "properties": {
        "consumer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "institution": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "authority_domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "expected"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "version",
            "fingerprint"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "clock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "system_utc"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "as_of"
          ],
          "properties": {
            "kind": {
              "const": "fixed_instant"
            },
            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "namespace",
        "reference",
        "anchor_reference"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "anchor_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_publisher_ref",
        "enforcing_operator_ref",
        "state_admin_ref"
      ],
      "properties": {
        "snapshot_publisher_ref": {
          "type": "string",
          "minLength": 1
        },
        "enforcing_operator_ref": {
          "type": "string",
          "minLength": 1
        },
        "state_admin_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
